2. Дамп БД с хостинга → локально
На сервере (SSH):

mkdir -p ~/db_dumps

mysqldump \
  --host=localhost \
  --user='u3380258_code-doctor' \
  --password \
  --default-character-set=utf8mb4 \
  --set-charset \
  --single-transaction \
  --quick \
  --routines \
  --triggers \
  --events \
  --hex-blob \
  --no-tablespaces \
  --result-file="$HOME/db_dumps/codedoctor_utf8mb4.sql" \
  'u3380258_code-doctor'

Локально (PowerShell):

scp u3380258@31.31.198.113:~/db_dumps/codedoctor_utf8mb4.sql C:\Users\admin\Desktop\

Локально (CMD, не PowerShell!):

cmd
"C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe" -u root -p --default-character-set=utf8mb4 -e "DROP DATABASE IF EXISTS codedoctor_local; CREATE DATABASE codedoctor_local CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

"C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe" --default-character-set=utf8mb4 --binary-mode=1 -u root -p codedoctor_local < "C:\Users\admin\Desktop\codedoctor_utf8mb4.sql"

